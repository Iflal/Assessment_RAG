# Used by the generation stage (not required for ingestion).
GROQ_API_KEY=

# Local ingestion/index settings.
RAG_CHROMA_PATH=.chroma
RAG_COLLECTION_NAME=rag-documents
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35
RAG_GROQ_MODEL=openai/gpt-oss-120b
RAG_MAX_COMPLETION_TOKENS=800
